# Copy this file to `.env` and adjust the values for your deployment.
# `.env` is git-ignored; never commit real credentials.
# Compose reads `.env` automatically from the project root.

# --- Reverse proxy ----------------------------------------------------------
# Public hostname used by Traefik. It must be a real, resolvable domain for
# Let's Encrypt (ACME) to issue certificates.
DOMAIN=example.com

# The ACME (Let's Encrypt) certificate resolver is configured directly in
# deploy/traefik/traefik.yml (Traefik cannot read it from the environment).
# Set your contact email there, or switch to the staging endpoint while testing.

# --- Host ports -------------------------------------------------------------
# Docker (rootful) can bind 80 and 443. Rootless Podman cannot bind ports below
# 1024 by default, so set these to e.g. 8080/8443 in that case (or lower
# net.ipv4.ip_unprivileged_port_start on the host).
HTTP_PORT=80
HTTPS_PORT=443

# Loopback port used for direct access to the web app when no proxy is running.
WEB_PORT=3000

# --- Authentication ---------------------------------------------------------
# REQUIRED. Signing key for session JWTs. The API refuses to start in
# production (APP_ENV=production) if this is missing or shorter than 32
# characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Lifetime of an issued token, in seconds. Defaults to 24 hours.
JWT_EXPIRATION_SECS=86400

# Set to `true` when the app is served over HTTPS so the session cookie gets the
# `Secure` attribute (Traefik profile, or TLS terminated upstream of nginx).
# Leave `false` for plain-HTTP deployments such as a bare `docker compose up`.
COOKIE_SECURE=false

# --- Server management (agent) ----------------------------------------------
# Minecraft (PaperMC) containers are managed by a separate agent process, which
# `moon run dev` starts locally alongside the API and web. In a container
# deployment it runs as the `agent` service and AGENT_URL points at it instead.
AGENT_URL=http://127.0.0.1:9091

# REQUIRED whenever AGENT_URL is set. Shared secret for API <-> agent requests
# (at least 16 characters). Generate one with:
#   openssl rand -hex 32
AGENT_TOKEN=

# --- Local development (optional) -------------------------------------------
# These are only read when running the API/web outside Docker. The API loads
# this file automatically at startup; Compose ignores them and sets its own.
# SQLite file created next to the API crate on first run (migrations run at
# startup; no separate migrate step).
# DATABASE_URL=sqlite://pumapanel.db
# Target of the web app's `/api/*` rewrite (read at build time).
# API_URL=http://127.0.0.1:3001
